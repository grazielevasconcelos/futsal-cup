---
import type { Competition, Match, PlayoffSnapshots, TeamId } from '../lib/domain/types';
import { buildPlayerTeamMap, buildTeamMap } from '../lib/domain/players';
import { buildExpectedSemifinalists } from '../lib/domain/playoffs';
import { resolveMatchTeams } from '../lib/domain/score';
import { rankTeams } from '../lib/domain/standings';
import { formatDate, formatTime } from '../lib/format/date';
import {
  formatStage,
  walkoverReasonLabel,
} from '../lib/format/match';
import { withBase } from '../lib/site';
import Score from './Score.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  match: Match;
  competition: Competition;
  now: Date;
  showStage?: boolean;
}

const { match, competition, now, showStage = true } = Astro.props;

const teams = buildTeamMap(competition);
const playerTeams = buildPlayerTeamMap(competition);
const snapshots: PlayoffSnapshots = {
  semifinalists: competition.semifinalists,
  finalists: competition.finalists,
};

let resolved: { homeTeamId: TeamId; awayTeamId: TeamId } | null = null;
try {
  resolved = resolveMatchTeams(match, snapshots);
} catch {
  resolved = null;
}

let homeName =
  resolved === null ? 'A definir' : teams.get(resolved.homeTeamId)?.name ?? 'A definir';
let awayName =
  resolved === null ? 'A definir' : teams.get(resolved.awayTeamId)?.name ?? 'A definir';

if (resolved === null && match.stage === 'final') {
  const ranking = rankTeams(competition);
  const leader = ranking.rows[0];
  homeName = leader === undefined ? '1º colocado' : teams.get(leader.teamId)?.name ?? '1º colocado';
  awayName = 'Vencedora da semifinal';
}

if (resolved === null && match.stage === 'semi') {
  const expected = buildExpectedSemifinalists(competition);
  if (expected !== null) {
    homeName = teams.get(expected[0])?.name ?? '2º colocado';
    awayName = teams.get(expected[1])?.name ?? '3º colocado';
  } else {
    homeName = '2º colocado';
    awayName = '3º colocado';
  }
}

const title = `${homeName} x ${awayName}`;
const href = withBase(`/jogos/${match.id}/`);
const time = match.startsAt === null ? 'Horário a definir' : formatTime(match.startsAt);
const venue = match.venue ?? 'Local a definir';
---

<article class="card match-card">
  <p class="match-card__top">
    {showStage && <span class="match-card__stage">{formatStage(match)}</span>}
    <StatusBadge match={match} now={now} />
  </p>

  <h3 class="match-card__title"><a href={href}>{title}</a></h3>

  <p class="match-card__meta">
    <time datetime={match.date}>{formatDate(match.date)}</time> · {time} · {venue}
  </p>

  {
    match.status === 'finished' && (
      <Score
        match={match}
        snapshots={snapshots}
        homeName={homeName}
        awayName={awayName}
        playerTeams={playerTeams}
      />
    )
  }

  {
    match.walkover !== null && (
      <p class="match-card__extra">
        W.O. — {walkoverReasonLabel(match.walkover.reason)}
        {match.walkover.note === null ? '' : `: ${match.walkover.note}`}
      </p>
    )
  }
</article>
