---
import { withBase } from '../lib/site';

interface Props {
  logo: string | null;
  size?: 'compact' | 'default' | 'large';
}

const { logo, size = 'default' } = Astro.props;
const isFallback = logo === null;
---

<img
  class:list={[
    'team-logo',
    {
      'team-logo--compact': size === 'compact',
      'team-logo--large': size === 'large',
      'team-logo--fallback': isFallback,
    },
  ]}
  src={withBase(logo ?? '/images/escudo-vazio.svg')}
  alt=""
  aria-hidden="true"
  width="548"
  height="600"
  loading="lazy"
  decoding="async"
/>
