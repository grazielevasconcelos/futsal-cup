---
import { withBase } from '../lib/site';

interface Props {
  logo: string | null;
  size?: 'default' | 'large';
}

const { logo, size = 'default' } = Astro.props;
---

{
  logo !== null && (
    <img
      class:list={['team-logo', { 'team-logo--large': size === 'large' }]}
      src={withBase(logo)}
      alt=""
      aria-hidden="true"
      width="548"
      height="600"
      loading="lazy"
      decoding="async"
    />
  )
}
