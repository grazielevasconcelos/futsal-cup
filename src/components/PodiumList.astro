---
import type { Podium, Team, TeamId } from '../lib/domain/types';
import { formatTeamLabel } from '../lib/format/team';

interface Props {
  podium: Podium;
  teams: ReadonlyMap<TeamId, Team>;
}

const { podium, teams } = Astro.props;

const places = [
  { label: 'Campeã', teamId: podium.champion, champion: true },
  { label: 'Vice-campeã', teamId: podium.runnerUp, champion: false },
  { label: '3ª colocada', teamId: podium.third, champion: false },
].filter(
  (place): place is { label: string; teamId: TeamId; champion: boolean } =>
    place.teamId !== null,
);
---

<ol class="podium">
  {
    places.map((place) => (
      <li
        class:list={['podium__item', { 'podium__item--champion': place.champion }]}
      >
        <p class="meta">{place.label}:</p>
        <p class="podium__team">
          {teams.get(place.teamId) === undefined
            ? place.teamId
            : formatTeamLabel(teams.get(place.teamId)!)}
        </p>
      </li>
    ))
  }
</ol>
