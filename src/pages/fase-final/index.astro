---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalPhase from '../../components/FinalPhase.astro';
import FriendlyCard from '../../components/FriendlyCard.astro';
import { loadCompetition } from '../../lib/data/load';
import { buildFriendlyCard } from '../../lib/domain/friendly';
import { getBuildDate } from '../../lib/site';

const competition = loadCompetition();
const now = getBuildDate();
const friendly = buildFriendlyCard(competition);
---

<BaseLayout
  title="Fase final"
  description="Final única entre o 1º e o 2º colocados, card informativo do amistoso e pódio de três posições da Copa de Futsal Feminino Vila Mariana 2026."
  activeNav="fase-final"
  notices={competition.notices}
>
  <div class="page">
    <div class="page-header">
      <h1>Fase final</h1>
      <p class="lead">
        Final única entre o 1º e o 2º colocados e pódio de três posições.
      </p>
    </div>

    {
      friendly !== null && (
        <section class="section" aria-labelledby="amistoso">
          <h2 id="amistoso">Amistoso do 3º colocado</h2>
          <FriendlyCard friendly={friendly} />
        </section>
      )
    }

    <FinalPhase competition={competition} now={now} />

    <section class="section" aria-labelledby="como-funciona">
      <h2 id="como-funciona">Como funciona</h2>
      <ul>
        <li>Apenas o 1º e o 2º colocados da fase classificatória disputam a final, em partida única.</li>
        <li>Não há semifinais.</li>
        <li>
          Empate no tempo normal vai direto para os pênaltis: cinco cobranças alternadas e morte
          súbita, se necessário.
        </li>
        <li>
          A 3ª colocada é a 3ª da classificação da fase classificatória, sem partida extra.
        </li>
        <li>
          O amistoso do 3º colocado é informativo e não altera classificação, estatísticas,
          suspensões ou pódio.
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
