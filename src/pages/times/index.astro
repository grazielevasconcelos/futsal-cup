---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import TeamBadges from '../../components/TeamBadges.astro';
import TeamStatsList from '../../components/TeamStatsList.astro';
import TeamLogo from '../../components/TeamLogo.astro';
import { loadCompetition } from '../../lib/data/load';
import { activePlayers } from '../../lib/domain/players';
import { rankTeams } from '../../lib/domain/standings';
import { buildTeamStats } from '../../lib/domain/stats';
import { withBase } from '../../lib/site';
import { formatTeamLabel } from '../../lib/format/team';

const competition = loadCompetition();
const ranking = rankTeams(competition);
const teamStats = buildTeamStats(competition);

const statsByTeam = new Map(teamStats.map((stats) => [stats.teamId, stats]));
const positionByTeam = new Map(ranking.rows.map((row) => [row.teamId, row.position]));
---

<BaseLayout
  title="Times"
  description="Os três times da Copa de Futsal Feminino Vila Mariana 2026, com elencos ativos, posições e estatísticas coletivas."
  activeNav="times"
  notices={competition.notices}
>
  <div class="page">
    <div class="page-header">
      <h1>Times</h1>
      <p class="lead">
        Os três times da edição, com elenco ativo e campanha na fase classificatória e na final.
      </p>
    </div>

    <section class="section" aria-labelledby="lista-times">
      <h2 id="lista-times">Os três times</h2>

      {
        competition.teams.length === 0 ? (
          <EmptyState
            title="Times indisponíveis"
            description="Ainda não há times cadastrados na fonte oficial da competição."
          />
        ) : (
          <ul class="team-grid">
            {competition.teams.map((team) => {
              const stats = statsByTeam.get(team.id);
              const active = activePlayers(team).length;
              const position = positionByTeam.get(team.id);

              return (
                <li>
                  <article class="card team-card">
                    <div class="team-card__header">
                      <TeamLogo logo={team.logo} />
                      <div class="team-card__heading">
                        <TeamBadges activeCount={active} />
                        <h3 class="card__title">
                          <a class="card__link" href={withBase(`/times/${team.id}/`)}>
                            {formatTeamLabel(team)}
                          </a>
                        </h3>
                      </div>
                    </div>
                    <p class="meta team-card__meta">
                      {position === undefined ? 'Sem posição' : `${position}º na classificação`} ·{' '}
                      {active} atletas ativas
                    </p>
                    {stats !== undefined && <TeamStatsList stats={stats} />}
                  </article>
                </li>
              );
            })}
          </ul>
        )
      }
    </section>

    <p class="meta">
      As estatísticas coletivas somam as oito partidas oficiais. Um empate na semifinal ou na
      final conta como empate; a vantagem do empate define quem avança ou é campeã e não altera o
      placar.
    </p>
  </div>
</BaseLayout>
