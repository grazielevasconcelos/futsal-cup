---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MatchCard from '../../components/MatchCard.astro';
import { loadCompetition } from '../../lib/data/load';
import { canonicalOrder } from '../../lib/domain/order';
import type { Match } from '../../lib/domain/types';
import { formatDateHeading } from '../../lib/format/date';
import { getBuildDate, withBase } from '../../lib/site';

const competition = loadCompetition();
const now = getBuildDate();

const matches = competition.matches.slice().sort((a, b) => {
  if (a.date !== b.date) return a.date < b.date ? -1 : 1;
  return canonicalOrder(a.id) - canonicalOrder(b.id);
});

const days = new Map<string, Match[]>();
for (const match of matches) {
  const list = days.get(match.date);
  if (list === undefined) days.set(match.date, [match]);
  else list.push(match);
}
---

<BaseLayout
  title="Jogos"
  description="Calendário completo das oito partidas oficiais da Copa de Futsal Feminino Vila Mariana 2026, com datas, horários e resultados."
  activeNav="jogos"
  notices={competition.notices}
>
  <div class="page">
    <div class="page-header">
      <h1>Jogos</h1>
      <p class="lead">
        As oito partidas oficiais: seis da fase classificatória, a semifinal e a final.
      </p>
    </div>

    {
      [...days.entries()].map(([date, dayMatches]) => (
        <section class="section" aria-labelledby={`dia-${date}`}>
          <h2 id={`dia-${date}`}>{formatDateHeading(date)}</h2>
          <ul class="card-grid">
            {dayMatches.map((match) => (
              <li>
                <MatchCard match={match} competition={competition} now={now} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="meta">
      A semifinal e a final aparecem com os participantes definidos pela classificação.
      <a href={withBase('/fase-final/')}> Ver a fase final</a>.
    </p>
  </div>
</BaseLayout>
