---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Score from '../../components/Score.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { loadCompetition } from '../../lib/data/load';
import { suspendedFor } from '../../lib/domain/discipline';
import { isMatchPast } from '../../lib/domain/home';
import { buildPlayerTeamMap, buildTeamMap } from '../../lib/domain/players';
import { buildExpectedSemifinalists, isGroupComplete } from '../../lib/domain/playoffs';
import { resolveMatchTeams } from '../../lib/domain/score';
import { rankTeams } from '../../lib/domain/standings';
import { formatDate, formatDateHeading, formatTime } from '../../lib/format/date';
import { buildEventViews } from '../../lib/format/events';
import { formatStage, walkoverReasonLabel } from '../../lib/format/match';
import { formatTeamLabel } from '../../lib/format/team';
import TeamLogo from '../../components/TeamLogo.astro';
import TeamIdentity from '../../components/TeamIdentity.astro';
import type { PlayoffSnapshots, TeamId } from '../../lib/domain/types';
import { getBuildDate, withBase } from '../../lib/site';

export function getStaticPaths() {
  const competition = loadCompetition();
  return competition.matches.map((match) => ({ params: { matchId: match.id } }));
}

const competition = loadCompetition();
const now = getBuildDate();
const match = competition.matches.find((item) => item.id === Astro.params.matchId);

if (match === undefined) {
  throw new Error(`Partida não encontrada: ${Astro.params.matchId ?? 'sem id'}`);
}

const teams = buildTeamMap(competition);
const playerTeams = buildPlayerTeamMap(competition);
const snapshots: PlayoffSnapshots = {
  semifinalists: competition.semifinalists,
  finalists: competition.finalists,
};

let resolved: { homeTeamId: TeamId; awayTeamId: TeamId } | null = null;
try {
  resolved = resolveMatchTeams(match, snapshots);
} catch {
  resolved = null;
}

const homeTeam = resolved === null ? undefined : teams.get(resolved.homeTeamId);
const awayTeam = resolved === null ? undefined : teams.get(resolved.awayTeamId);
let homeName = homeTeam === undefined ? 'A definir' : formatTeamLabel(homeTeam);
let awayName = awayTeam === undefined ? 'A definir' : formatTeamLabel(awayTeam);

if (resolved === null && match.stage === 'final') {
  homeName = '1º colocado';
  awayName = 'Vencedora da semifinal';
  if (isGroupComplete(competition)) {
    const ranking = rankTeams(competition);
    const leader = ranking.rows[0];
    const leaderTeam = leader === undefined ? undefined : teams.get(leader.teamId);
    if (leaderTeam !== undefined) homeName = formatTeamLabel(leaderTeam);
  }
}

if (resolved === null && match.stage === 'semi') {
  const expected = buildExpectedSemifinalists(competition);
  if (expected !== null) {
    const expectedHome = teams.get(expected[0]);
    const expectedAway = teams.get(expected[1]);
    homeName = expectedHome === undefined ? '2º colocado' : formatTeamLabel(expectedHome);
    awayName = expectedAway === undefined ? '3º colocado' : formatTeamLabel(expectedAway);
  } else {
    homeName = '2º colocado';
    awayName = '3º colocado';
  }
}

const title =
  match.stage === 'group'
    ? `${homeName} x ${awayName} — ${formatDate(match.date)}`
    : `${formatStage(match)} — ${formatDate(match.date)}`;

const status = match.status;
const pendingResult = status === 'scheduled' && isMatchPast(match, now);
const eventViews =
  status === 'finished' && resolved !== null
    ? buildEventViews(match, snapshots, playerTeams, teams)
    : [];

const suspensionIds = suspendedFor(match, competition);
const absences =
  resolved === null
    ? []
    : [resolved.homeTeamId, resolved.awayTeamId].flatMap((teamId) => {
        const team = teams.get(teamId);
        if (team === undefined) return [];
        const players = [...suspensionIds]
          .filter((playerId) => playerTeams.get(playerId)?.team.id === teamId)
          .map((playerId) => playerTeams.get(playerId)?.player.nickname)
          .filter((nickname): nickname is string => nickname !== undefined);
        return [{ team, players }];
      });

const time = match.startsAt === null ? 'Horário a definir' : formatTime(match.startsAt);
const venue = match.venue ?? 'Local a definir';

const description =
  match.stage === 'final'
    ? `Final da Copa de Futsal Feminino Vila Mariana 2026 em ${formatDate(match.date)}: ${homeName} x ${awayName}, placar, eventos e desfalques.`
    : match.stage === 'semi'
      ? `Semifinal da Copa de Futsal Feminino Vila Mariana 2026 em ${formatDate(match.date)}: ${homeName} x ${awayName}, placar, eventos e desfalques.`
      : `${homeName} x ${awayName} em ${formatDate(match.date)}: placar, eventos e desfalques da Copa de Futsal Feminino Vila Mariana 2026.`;

const missingSnapshotTitle =
  match.stage === 'semi' ? 'Semifinal a definir' : 'Final a definir';
const missingSnapshotText =
  match.stage === 'semi'
    ? 'A semifinal será disputada entre o 2º e o 3º colocados da fase classificatória, depois das seis partidas de grupo.'
    : 'A final será disputada entre o 1º colocado e a vencedora da semifinal, depois da semifinal.';
---

<BaseLayout
  title={title}
  description={description}
  activeNav="jogos"
  notices={competition.notices}
>
  <div class="page">
    <p class="meta page-back"><a href={withBase('/jogos/')}>Todos os jogos</a></p>

    <div class="page-header">
      <p class="badge-list">
        <span class="badge">{formatStage(match)}</span>
        <StatusBadge match={match} now={now} />
      </p>
      <h1 class="match-heading">
        {homeTeam === undefined ? (
          homeName
        ) : (
          <span class="team-identity">
            {homeName}
            <TeamLogo logo={homeTeam.logo} size="compact" />
          </span>
        )}
        {' x '}
        {awayTeam === undefined ? (
          awayName
        ) : (
          <span class="team-identity">
            {awayName}
            <TeamLogo logo={awayTeam.logo} size="compact" />
          </span>
        )}
      </h1>
      <p class="meta">
        {formatDateHeading(match.date)} · {time} · {venue}
      </p>

      {
        status === 'finished' && (
          <Score
            match={match}
            snapshots={snapshots}
            homeName={homeName}
            awayName={awayName}
            playerTeams={playerTeams}
            size="large"
          />
        )
      }
    </div>

    {
      resolved === null && (
        <section class="section" aria-labelledby="mata-mata-a-definir">
          <h2 id="mata-mata-a-definir">{missingSnapshotTitle}</h2>
          <p>{missingSnapshotText}</p>
          <p><a href={withBase('/classificacao/')}>Acompanhar a classificação</a></p>
        </section>
      )
    }

    {
      match.stage === 'semi' && (
        <p class="meta">
          O 2º colocado tem mando de campo e vantagem do empate: se a partida terminar empatada
          no tempo normal, o 2º avança. O W.O. prevalece sobre a vantagem.
        </p>
      )
    }

    {
      match.stage === 'final' && (
        <p class="meta">
          O 1º colocado tem mando de campo e vantagem do empate: se a final terminar empatada no
          tempo normal, o título é do 1º. O W.O. prevalece sobre a vantagem.
        </p>
      )
    }

    {
      status === 'postponed' && (
        <section class="section" aria-labelledby="partida-adiada">
          <h2 id="partida-adiada">Partida adiada</h2>
          <p>Nova data e horário serão publicados quando a organização confirmar.</p>
        </section>
      )
    }

    {
      status === 'scheduled' && (
        <section class="section" aria-labelledby="partida-agendada">
          <h2 id="partida-agendada">
            {pendingResult ? 'Resultado pendente' : 'Partida ainda não realizada'}
          </h2>
          <p>
            {pendingResult
              ? 'A data já passou e o resultado será publicado quando a organização registrar os eventos.'
              : 'O placar e os eventos serão publicados depois da partida.'}
          </p>
        </section>
      )
    }

    {
      status === 'finished' && match.walkover !== null && (
        <section class="section" aria-labelledby="wo">
          <h2 id="wo">Vitória por W.O. — {walkoverReasonLabel(match.walkover.reason)}</h2>
          {match.walkover.note !== null && <p>{match.walkover.note}</p>}
          {eventViews.length === 0 && <p>Sem eventos registrados.</p>}
        </section>
      )
    }

    {
      status === 'finished' && eventViews.length > 0 && (
        <section class="section" aria-labelledby="eventos">
          <h2 id="eventos">Eventos</h2>
          <ol class="event-list">
            {eventViews.map((event) => (
              <li class="event">
                <p class="event__minute">{event.minute}</p>
                <p class="event__description">{event.description}</p>
                {event.tags.length > 0 && (
                  <ul class="tag-list">
                    {event.tags.map((tag) => (
                      <li class="tag">{tag}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      absences.length > 0 && (
        <section class="section" aria-labelledby="desfalques">
          <h2 id="desfalques">Desfalques por suspensão</h2>
          {absences.map(({ team, players }) => (
            <div>
              <h3>
                <TeamIdentity label={formatTeamLabel(team)} logo={team.logo} />
              </h3>
              {players.length === 0 ? (
                <p>Nenhum desfalque por suspensão.</p>
              ) : (
                <ul>
                  {players.map((nickname) => (
                    <li>{nickname}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </section>
      )
    }

    <section class="section section--nav" aria-labelledby="navegar">
      <h2 id="navegar">Continuar</h2>
      <ul>
        <li><a href={withBase('/jogos/')}>Todos os jogos</a></li>
        <li><a href={withBase('/classificacao/')}>Classificação</a></li>
        {resolved !== null && (
          <li>
            <a href={withBase(`/times/${resolved.homeTeamId}/`)}>
              {homeTeam === undefined ? homeName : <TeamIdentity label={homeName} logo={homeTeam.logo} />}
            </a>
            {' e '}
            <a href={withBase(`/times/${resolved.awayTeamId}/`)}>
              {awayTeam === undefined ? awayName : <TeamIdentity label={awayName} logo={awayTeam.logo} />}
            </a>
          </li>
        )}
      </ul>
    </section>
  </div>
</BaseLayout>
