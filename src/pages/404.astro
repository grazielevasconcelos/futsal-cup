---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---

<BaseLayout
  title="Página não encontrada"
  description="Página não encontrada na Copa de Futsal Feminino Vila Mariana 2026. Volte para o início do site."
  noindex
>
  <section class="page">
    <h1>Página não encontrada</h1>
    <p class="lead">O endereço acessado não existe ou foi movido.</p>
    <p><a href={withBase('/')}>Voltar para o início</a></p>
  </section>
</BaseLayout>
