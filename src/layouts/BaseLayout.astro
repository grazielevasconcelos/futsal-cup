---
import NoticeBanner from '../components/NoticeBanner.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { loadCompetition } from '../lib/data/load';
import type { Notice } from '../lib/domain/types';
import { SITE_NAME, withBase } from '../lib/site';
import type { NavKey } from '../lib/site';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

interface Props {
  title?: string | undefined;
  description: string;
  activeNav?: NavKey | undefined;
  noindex?: boolean | undefined;
  notices?: readonly Notice[] | undefined;
}

const { title, description, activeNav, noindex = false, notices = [] } = Astro.props;

const teams = loadCompetition().teams;
const activeTeamId =
  teams.find((team) => Astro.url.pathname === withBase(`/times/${team.id}/`))?.id ?? null;

const pageTitle = !title || title === SITE_NAME ? SITE_NAME : `${title} — ${SITE_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline data-theme-script>
      (() => {
        const root = document.documentElement;
        const storageKey = 'futsal-cup-theme';
        const buttonSelector = '.theme-toggle';

        root.classList.remove('no-js');

        const updateButton = () => {
          const button = document.querySelector(buttonSelector);
          if (button) button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
        };

        let theme = 'light';
        try {
          if (localStorage.getItem(storageKey) === 'dark') theme = 'dark';
        } catch {
          /* O tema claro continua disponível quando o armazenamento não puder ser lido. */
        }
        root.dataset.theme = theme;

        document.addEventListener('DOMContentLoaded', () => {
          const button = document.querySelector(buttonSelector);
          updateButton();
          button?.addEventListener('click', () => {
            theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
            root.dataset.theme = theme;
            updateButton();
            try {
              localStorage.setItem(storageKey, theme);
            } catch {
              /* A alternância continua funcionando nesta página sem persistência. */
            }
          });
        });
      })();
    </script>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    {
      !noindex && (
        <>
          <link rel="canonical" href={canonicalUrl} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={SITE_NAME} />
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader activeNav={activeNav} activeTeamId={activeTeamId} teams={teams} />
    <NoticeBanner notices={notices} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
